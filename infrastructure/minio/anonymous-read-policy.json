{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadPlanImages",
      "Effect": "Allow",
      "Principal": {
        "AWS": ["*"]
      },
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::ilchul/plan/*"]
    },
    {
      "Sid": "PublicReadProfileImages",
      "Effect": "Allow",
      "Principal": {
        "AWS": ["*"]
      },
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::ilchul/users/profile/*"]
    }
  ]
}
