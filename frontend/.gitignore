# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

# claude code 
# /.claude/*
# /cc/*
/cc/input/*

# sample
/src/samples/*

# omc
/.omc/*

# notion temp
/.tmp-notion-export/
/.tmp-notion-refetch/
/scripts/

# QA 자동화 산출물 — 브라우저 프로필(로그인 쿠키)·의존성·로그·스크린샷은 커밋하지 않는다
/cc/result/*_qa_scripts/node_modules/
/cc/result/*_qa_scripts/profile/
/cc/result/*_qa_scripts/logs/
/cc/result/*_qa_scripts/screens/
/cc/result/*_screens/
